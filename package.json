{
  "name": "@dxyl/graphics",
  "version": "0.1.0",
  "description": "A dependency-free 2D/3D graphics library with pluggable backends (Canvas2D, SVG, WebGL, WebGPU).",
  "keywords": [
    "graphics",
    "2d",
    "3d",
    "webgl",
    "webgpu",
    "canvas2d",
    "svg",
    "renderer",
    "math",
    "geometry",
    "animation"
  ],
  "license": "MIT",
  "author": "dxyl",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./animation": {
      "types": "./dist/types/animation/index.d.ts",
      "import": "./dist/esm/animation/index.js",
      "require": "./dist/cjs/animation/index.cjs"
    },
    "./assets": {
      "types": "./dist/types/assets/index.d.ts",
      "import": "./dist/esm/assets/index.js",
      "require": "./dist/cjs/assets/index.cjs"
    },
    "./controls": {
      "types": "./dist/types/controls/index.d.ts",
      "import": "./dist/esm/controls/index.js",
      "require": "./dist/cjs/controls/index.cjs"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.cjs"
    },
    "./effects": {
      "types": "./dist/types/effects/index.d.ts",
      "import": "./dist/esm/effects/index.js",
      "require": "./dist/cjs/effects/index.cjs"
    },
    "./geometry": {
      "types": "./dist/types/geometry/index.d.ts",
      "import": "./dist/esm/geometry/index.js",
      "require": "./dist/cjs/geometry/index.cjs"
    },
    "./materials": {
      "types": "./dist/types/materials/index.d.ts",
      "import": "./dist/esm/materials/index.js",
      "require": "./dist/cjs/materials/index.cjs"
    },
    "./math": {
      "types": "./dist/types/math/index.d.ts",
      "import": "./dist/esm/math/index.js",
      "require": "./dist/cjs/math/index.cjs"
    },
    "./picking": {
      "types": "./dist/types/picking/index.d.ts",
      "import": "./dist/esm/picking/index.js",
      "require": "./dist/cjs/picking/index.cjs"
    },
    "./renderer": {
      "types": "./dist/types/renderer/index.d.ts",
      "import": "./dist/esm/renderer/index.js",
      "require": "./dist/cjs/renderer/index.cjs"
    },
    "./scene": {
      "types": "./dist/types/scene/index.d.ts",
      "import": "./dist/esm/scene/index.js",
      "require": "./dist/cjs/scene/index.cjs"
    },
    "./shaders": {
      "types": "./dist/types/shaders/index.d.ts",
      "import": "./dist/esm/shaders/index.js",
      "require": "./dist/cjs/shaders/index.cjs"
    },
    "./text": {
      "types": "./dist/types/text/index.d.ts",
      "import": "./dist/esm/text/index.js",
      "require": "./dist/cjs/text/index.cjs"
    },
    "./textures": {
      "types": "./dist/types/textures/index.d.ts",
      "import": "./dist/esm/textures/index.js",
      "require": "./dist/cjs/textures/index.cjs"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.cjs"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.cjs"
    },
    "./wasm": {
      "types": "./dist/types/wasm/index.d.ts",
      "import": "./dist/esm/wasm/index.js",
      "require": "./dist/cjs/wasm/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/types/*"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node --experimental-strip-types scripts/build.ts",
    "build:quick": "node --experimental-strip-types scripts/build.ts --skip-verify",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "vite build",
    "build:verify": "node scripts/verify-build.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:deps": "node scripts/verify-deps.mjs",
    "verify:encoding": "node scripts/verify-encoding.mjs",
    "verify:brand": "node scripts/verify-brand.mjs",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:serve": "node --experimental-strip-types scripts/dev.ts --serve",
    "dev:example":"vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "api": "node scripts/run-api-extractor.mjs",
    "generate:api": "node --experimental-strip-types scripts/generate-api.ts",
    "generate:api:check": "node --experimental-strip-types scripts/generate-api.ts --check",
    "generate:shaders": "node --experimental-strip-types scripts/generate-shaders.ts",
    "generate:shaders:check": "node --experimental-strip-types scripts/generate-shaders.ts --check",
    "generate:assets": "node --experimental-strip-types scripts/copy-assets.ts",
    "release": "node --experimental-strip-types scripts/release.ts",
    "playground": "vite --config playground/vite.config.ts",
    "verify": "pnpm run verify:structure && pnpm run verify:deps && pnpm run verify:encoding && pnpm run verify:brand && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "typedoc": "^0.27.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-glsl": "^1.3.1",
    "vitest": "^3.0.5"
  }
}
