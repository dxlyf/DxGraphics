/**
 * Playwright configuration for the end-to-end suite — an EXAMPLE, not an active config.
 *
 * Playwright is deliberately **not** a dependency of this repository, so this file is named
 * `playwright.config.ts.example` and Playwright never picks it up. To use it:
 *
 *   1. install Playwright in your own environment (not in package.json):
 *        npm i -D @playwright/test
 *        npx playwright install chromium
 *   2. copy this file:
 *        cp tests/e2e/playwright.config.ts.example tests/e2e/playwright.config.ts
 *   3. run:
 *        npx playwright test --config tests/e2e/playwright.config.ts
 *
 * See tests/e2e/README.md for the flow and for the assertion each example deserves.
 */

import { defineConfig, devices } from '@playwright/test';

export default defineConfig({
  /** Specs live beside this config. */
  testDir: '.',

  /** `tests/e2e/README.md` is not a spec. */
  testMatch: /.*\.spec\.ts$/,

  /**
   * Serial execution.
   *
   * Every spec drives a rendering loop on a shared GPU, so running them in parallel makes
   * frame timing — and therefore any pixel or FPS assertion — non-deterministic.
   */
  fullyParallel: false,
  workers: 1,

  /** A retry only on CI, where a runner can lose its GPU mid-run. */
  retries: process.env.CI ? 1 : 0,

  /** Fail the run if a spec was left with `.only`, so a narrowed run cannot pass CI. */
  forbidOnly: Boolean(process.env.CI),

  /** Per-test budget: page load, first frame, interaction and teardown. */
  timeout: 30_000,

  /** Per-assertion budget. Kept short: the assertions here are all condition-based. */
  expect: { timeout: 5_000 },

  reporter: process.env.CI
    ? [['list'], ['html', { outputFolder: 'playwright-report', open: 'never' }]]
    : [['list']],

  outputDir: 'test-results',

  use: {
    /** Localhost is a secure context, which `navigator.gpu` and some canvas APIs require. */
    baseURL: 'http://127.0.0.1:5175',

    /**
     * A fixed viewport and DPR.
     *
     * The examples size their drawing buffer as CSS size × `devicePixelRatio`. Letting either
     * vary per machine makes canvas dimensions and any pixel assertion machine-dependent, so
     * both are pinned here.
     */
    viewport: { width: 1280, height: 800 },
    deviceScaleFactor: 1,

    /** Surface console and page errors as test failures rather than as noise. */
    trace: 'retain-on-failure',
    screenshot: 'only-on-failure',
    video: 'off',

    /**
     * Chromium flags that make headless rendering deterministic.
     *
     * `--use-gl=swiftshader` forces software GL, so a CI runner without a GPU still produces
     * pixels; the cost is speed, which is why the CPU-only cases are the ones expected to run
     * here. The WebGL and WebGPU specs should be skipped when this is in effect — see the
     * note in the README about `backend` detection.
     */
    launchOptions: {
      args: [
        '--use-gl=swiftshader',
        '--enable-unsafe-swiftshader',
        '--disable-gpu-sandbox',
        // Deterministic text and animation rendering.
        '--font-render-hinting=none',
        '--disable-lcd-text',
        '--force-device-scale-factor=1',
      ],
    },
  },

  projects: [
    {
      name: 'chromium',
      use: { ...devices['Desktop Chrome'] },
    },
  ],

  /**
   * Vite serves the examples, because they import `../../src/index` and that specifier only
   * resolves through a bundler's transform pipeline. A `file://` load fails at module
   * resolution and would test nothing.
   *
   * One server on one port, with the example chosen per spec via `page.goto('/examples/<name>/')`
   * — Vite serves the whole repository root, so a single server covers every example.
   */
  webServer: {
    command: 'pnpm exec vite --port 5175 --strictPort',
    url: 'http://127.0.0.1:5175/examples/2d-basic/',
    reuseExistingServer: !process.env.CI,
    timeout: 60_000,
    stdout: 'pipe',
    stderr: 'pipe',
  },
});
